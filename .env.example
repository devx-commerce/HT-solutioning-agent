# Copy to .env for local reference — Cloud Run gets these via --set-env-vars,
# not a .env file, since this is meant to run deployed, not locally.

GOOGLE_CLOUD_PROJECT=academic-diode-477405-m3
GOOGLE_CLOUD_LOCATION=us-central1

# --- shared Drive/Slides identity ----------------------------------------
# One consented identity, bootstrapped once via scripts/get_refresh_token.py,
# logged in as sales.agent@hindustantimes.com. Owns Drive/Slides regardless
# of which mailbox a request came from.
#   projects/PROJECT_NUMBER/secrets/solutioning-agent-oauth/versions/latest
OAUTH_TOKEN_SECRET=

# --- Gmail self-serve onboarding ------------------------------------------
# One OAuth client (Web application type, not Desktop — needs a redirect
# URI), shared by every account manager who onboards. Holds only
# {"client_id","client_secret"} — no per-user data.
#   projects/PROJECT_NUMBER/secrets/solutioning-agent-oauth-client/versions/latest
OAUTH_CLIENT_SECRET=
# Random string used to sign the OAuth state parameter. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
STATE_SIGNING_KEY=
# Only accounts on this domain can self-onboard via /oauth/gmail/start.
# The consent screen is Internal (see README step 2), so this is really a
# second, redundant check — cheap insurance, not the primary control.
ALLOWED_ONBOARD_DOMAIN=hindustantimes.com
# Set to *this deployment's* own URL after first deploy — must exactly
# match a redirect URI on the OAuth client.
SERVICE_URL=
# true only on the onboarding deployment (solutioning-agent-onboarding).
# Restricts which routes get registered at all — /sweep, /work, /status,
# /handle_message don't exist on that deployment, not just unprotected.
# Leave unset (false) on the main solutioning-agent deployment.
PUBLIC_ROUTES_ONLY=false

# BigQuery
BQ_DATASET=solutioning_agent

# The reasoningEngines/... resource name from `adk deploy agent_engine`
# (README step 9) — /handle_message calls this directly, not through GE.
AGENT_ENGINE_RESOURCE=

GEMINI_MODEL=gemini-2.5-flash

# --- deck rendering ---------------------------------------------------------
# presentation-md's renderer CLI: Deck JSON on stdin, pptx out. Nothing in the
# deployed topology can run Node yet (Agent Engine is managed Python, Cloud Run
# builds from buildpacks) — see docs/research-and-rendering-decisions.md.
PRESENTATION_MD_CLI=
NODE_BIN=node
# Optional Drive folder for generated decks; blank puts them in My Drive.
DECK_FOLDER_ID=
# Domain that gets read-only access to every generated deck. Blank leaves the
# deck private to the agent identity, which means nobody else can open it.
DECK_READER_DOMAIN=hindustantimes.com

# --- research ---------------------------------------------------------------
RESEARCH_MODEL=gemini-2.5-flash
# The Gemini Enterprise app the past-decks Drive connector is attached to.
# Searched through the app rather than the data store because the connector
# runs FEDERATED — it queries Drive live instead of building an index.
# Blank makes search_past_decks report itself unavailable rather than imply
# no prior work exists.
PAST_DECKS_ENGINE=ht-sales-pitch-agent_1789729673554
# Must match the app's region; it is immutable on both and they have to agree.
PAST_DECKS_LOCATION=us
# The connector has no folder scoping, so results are filtered to this
# folder's own file ids. Required — see docs/open-items.md.
PAST_DECKS_FOLDER_ID=1W7C53D5nLxFQTX0GuAeaIYWzjuWVr7MO
# YouTube Data API v3 key. Blank disables search_youtube cleanly.
YOUTUBE_API_KEY=

# ADK talks to Vertex AI rather than the Gemini API key path without this.
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# --- ingestion pipeline (docs/EMAIL-POLLER-DESIGN.md) ---------------------
# The solutioning briefs sheet — created once by hand, same pattern as the Slides
# template above. Must be shared with sales.agent@hindustantimes.com (or
# whichever account holds OAUTH_TOKEN_SECRET) as an Editor; `spreadsheets`
# scope reaches any sheet that account can edit, not just files it created.
BRIEFS_SHEET_ID=
BRIEFS_SHEET_RANGE=Sheet1!A:I
# Cheap model for per-email classification/extraction — deliberately not
# the same (larger) model the agent itself uses.
CLASSIFY_MODEL=gemini-2.0-flash-lite
# The Pub/Sub topic /sweep publishes build-work to, and /work consumes
# from — see README step 7 for why this exists (concurrency control, not
# just reliability).
BUILD_WORK_TOPIC=solutioning-agent-build-work
# Where the deck-built notification is sent — solutioning's own inbox,
# never the sender of the triggering email. Required; /work raises if unset.
SOLUTIONING_NOTIFY_EMAIL=sales.agent@hindustantimes.com
