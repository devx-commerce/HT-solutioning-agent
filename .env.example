# Copy to .env for local reference — Cloud Run gets these via --set-env-vars,
# not a .env file, since this is meant to run deployed, not locally.

GOOGLE_CLOUD_PROJECT=ht-pitch-agent-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# --- shared Drive/Slides identity ----------------------------------------
# One consented identity, bootstrapped once via scripts/get_refresh_token.py.
# Owns Drive/Slides regardless of which mailbox a request came from.
#   projects/PROJECT_NUMBER/secrets/pitch-agent-oauth/versions/latest
OAUTH_TOKEN_SECRET=

# --- Gmail self-serve onboarding ------------------------------------------
# One OAuth client (Web application type, not Desktop — needs a redirect
# URI), shared by every account manager who onboards. Holds only
# {"client_id","client_secret"} — no per-user data.
#   projects/PROJECT_NUMBER/secrets/pitch-agent-oauth-client/versions/latest
OAUTH_CLIENT_SECRET=
# Random string used to sign the OAuth state parameter. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
STATE_SIGNING_KEY=
# Only accounts on this domain can self-onboard via /oauth/gmail/start.
# Leave blank while testing solo with a personal-ish account; set to
# hindustantimes.com once real account managers are onboarding.
ALLOWED_ONBOARD_DOMAIN=
# Set to the Cloud Run service's own URL after first deploy (README 6b) —
# must exactly match a redirect URI on the OAuth client.
SERVICE_URL=

# BigQuery
BQ_DATASET=pitch_agent_skeleton

# The reasoningEngines/... resource name from `adk deploy agent_engine`
# (README step 9) — /handle_message calls this directly, not through GE.
AGENT_ENGINE_RESOURCE=

# Drive: one template deck with {{CLIENT_NAME}} and {{NOTES}} placeholders,
# owned by whoever ran get_refresh_token.py.
TEMPLATE_FILE_ID=

GEMINI_MODEL=gemini-2.5-flash
